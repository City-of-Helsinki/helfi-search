#!/usr/bin/env php
<?php

/**
 * Full crawl of every site in crawler.yml.
 *
 * Usage: crawl [--limit-per-domain=N]
 *
 *   By default, runs one crawl with crawler.yml as is: every page of every
 *   site, then the purge step that removes documents for pages that are gone.
 *
 *   --limit-per-domain=N  For development: crawl at most about N URLs per
 *                         site. Runs one crawl per site, without the purge
 *                         step. 0 means no limit (same as leaving it out).
 *
 * The crawler counts every URL it handles toward the limit, including
 * redirects and non-HTML files, so a site gets at most N documents, usually
 * fewer.
 *
 * Limited crawls don't purge: a purge deletes every document the crawl didn't
 * visit, which would include the other sites and every page past the limit.
 * Documents from earlier crawls stay in the index.
 */

declare(strict_types=1);

use App\CrawlerConfig;
use App\StderrLogger;
use App\Worker\Crawler;
use App\Worker\Elasticsearch;

require dirname(__DIR__) . '/vendor/autoload.php';

$options = getopt('', ['limit-per-domain:']);
$limit = (int) ($options['limit-per-domain'] ?? 0);
if ($limit < 0) {
    fwrite(STDERR, "--limit-per-domain must be 0 or more.\n");
    exit(2);
}

$logger = new StderrLogger();

try {
    $config = CrawlerConfig::fromFile(CrawlerConfig::path());
    Elasticsearch::fromConfig($config)->waitUntilReady();

    $crawler = new Crawler();
    $settings = $config->toArray();

    if ($limit === 0) {
        $logger->info('Crawling all sites.');
        $crawler->crawl($settings);
        exit(0);
    }

    foreach ($config->domains() as $domain) {
        $logger->info('Crawling at most {limit} URLs of {site}.', ['limit' => $limit, 'site' => $domain['url']]);
        $crawler->crawl([
            'domains' => [$domain],
            'max_unique_url_count' => $limit,
            'purge_crawl_enabled' => false,
        ] + $settings);
    }
} catch (\Throwable $e) {
    $logger->error('{error}', ['error' => $e->getMessage(), 'exception' => $e]);
    exit(1);
}
