#!/usr/bin/env php
<?php

/**
 * The worker's commands: app:worker (apply the queued changes), app:crawl
 * (full crawl) and app:queue (the queue's state). Run "bin/console list app"
 * for the list.
 */

declare(strict_types=1);

use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

require_once dirname(__DIR__) . '/vendor/autoload_runtime.php';

return static fn (array $context): Application => new Application(Kernel::fromContext($context));
