{
    "name": "city-of-helsinki/helfi-search",
    "description": "Indexes hel.fi sites into Elasticsearch: a webhook queues content changes, and a worker reindexes them with Elastic Open Crawler.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.10",
        "psr/log": "^3.0",
        "symfony/console": "7.4.*",
        "symfony/filesystem": "^7.3",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "^7.3",
        "symfony/monolog-bundle": "^4.1",
        "symfony/process": "^7.3",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "7.4.*"
    },
    "suggest": {
        "ext-pcntl": "The worker uses it to stop cleanly on SIGTERM; the worker image installs it."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "require": "7.4.*"
        },
        "runtime": {
            "disable_dotenv": true
        }
    }
}
