# Local settings and secrets (WEBHOOK_TOKEN).
.env
.env.local

# Composer dependencies; installed during the image builds.
/vendor/

# Local runtime data (the queue folder).
/var/

# PHPUnit's cache.
/.phpunit.cache/

# Test results and logs (GitHub Actions).
/results/

# IDE settings.
/.idea/

# Generated by Symfony in the dev environment.
/config/reference.php
