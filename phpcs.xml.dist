<?xml version="1.0"?>
<ruleset name="helfi-search">
    <description>PSR-12, the PHP-FIG coding style.</description>

    <file>src</file>
    <file>tests</file>
    <file>public</file>
    <file>bin/console</file>
    <file>config/bundles.php</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>
</ruleset>
